FAST_TG_DOWNLOAD = "True"           # Stream Telegram files via a local, loopback-only HTTP link with parallel byte-range fetches instead of a single download_media() stream (faster). Falls back automatically on error. Set "False" to always use the classic path.
ADDITIONAL_BOT_TOKENS = ""          # Optional, comma-separated extra bot tokens from @BotFather (e.g. "111:AAA,222:BBB"). Each token is its own Telegram session, so FAST_TG_DOWNLOAD can split a file's byte-ranges across them for real extra bandwidth (splitting across ONE session does not help — Telegram throttles per-session). Leave empty to only use the main bot + premium user session (if configured).
BIN_CHANNEL = "-1004466466955"                    # Optional private channel ID (e.g. "-1001234567890"). Add the main bot, the premium user (if any), and every ADDITIONAL_BOT_TOKENS bot there as admins. FAST_TG_DOWNLOAD then copies each leeched message into this channel so every session can independently pull a valid copy — without this, extra sessions only help when they already happen to be members of the exact source chat.

